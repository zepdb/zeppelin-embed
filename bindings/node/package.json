{
  "name": "@zepdb/zeppelin-embed",
  "version": "0.4.2",
  "description": "In-process vector search for macOS (Apple silicon and Intel) and Windows x64",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zepdb/zeppelin-embed.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/zepdb/zeppelin-embed#readme",
  "bugs": "https://github.com/zepdb/zeppelin-embed/issues",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "prebuilds/darwin-arm64/zeppelin_embed.node",
    "prebuilds/darwin-x64/zeppelin_embed.node",
    "prebuilds/win32-x64/node-napi8/zeppelin_embed.node",
    "prebuilds/win32-x64/electron-44/zeppelin_embed.node"
  ],
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "check:prebuilt": "node scripts/check-prebuilt.mjs",
    "prepack": "npm run check:prebuilt",
    "smoke:install": "node scripts/install-smoke.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:release": "node scripts/verify-release-tarball.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "node-gyp": "12.4.0",
    "typescript": "5.9.2"
  },
  "keywords": [
    "vector-search",
    "embedded",
    "search",
    "macos",
    "apple-silicon",
    "windows"
  ]
}
