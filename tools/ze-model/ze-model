#!/usr/bin/env python3
"""Fetch Hugging Face checkpoints and bake immutable Zeppelin .zem bundles."""

from __future__ import annotations

import argparse
import json
import math
import struct
from dataclasses import dataclass
from pathlib import Path
import torch
import xxhash
from huggingface_hub import snapshot_download
from safetensors import safe_open

MAGIC = b"ZEMB0001"
VERSION = 1


@dataclass(frozen=True)
class Tensor:
    name: str
    shape: tuple[int, ...]
    data: bytes
    digest: int


@dataclass(frozen=True)
class Tower:
    role: int
    model_id: str
    root: Path
    prefix: str
    config: dict
    pooling: int
    architecture: int
    dense_out: int
    tensors: tuple[Tensor, ...]
    weights_digest: bytes


def u16(value: int) -> bytes:
    return struct.pack("<H", value)


def u32(value: int) -> bytes:
    return struct.pack("<I", value)


def u64(value: int) -> bytes:
    return struct.pack("<Q", value)


def field(value: bytes) -> bytes:
    return u32(len(value)) + value


def string(value: str) -> bytes:
    return field(value.encode("utf-8"))


def json_file(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as source:
        return json.load(source)


def checkpoint_tensor(path: Path, name: str) -> torch.Tensor:
    with safe_open(path, framework="pt", device="cpu") as source:
        return source.get_tensor(name)


def load_tensors(root: Path, role_name: str, dense_out: int) -> tuple[Tensor, ...]:
    model = root / "model.safetensors"
    if not model.is_file():
        raise ValueError(f"checkpoint has no model.safetensors: {root}")
    values: list[tuple[str, torch.Tensor]] = []
    with safe_open(model, framework="pt", device="cpu") as source:
        for name in source.keys():
            values.append((name, source.get_tensor(name)))
    if dense_out:
        dense = root / "2_Dense" / "model.safetensors"
        if not dense.is_file():
            raise ValueError(f"Dense head declared but absent: {dense}")
        values.extend(
            (f"dense.{name.removeprefix('linear.')}", checkpoint_tensor(dense, name))
            for name in ("linear.weight", "linear.bias")
        )
    tensors = []
    for name, value in values:
        value = value.detach().to(dtype=torch.float32).contiguous()
        data = value.numpy().astype("<f4", copy=False).tobytes(order="C")
        tensors.append(
            Tensor(
                name=f"{role_name}/{name}",
                shape=tuple(value.shape),
                data=data,
                digest=xxhash.xxh3_64_intdigest(data),
            )
        )
    return tuple(tensors)


def declared_query_prefix(root: Path) -> str:
    config_path = root / "config_sentence_transformers.json"
    if not config_path.is_file():
        return ""
    prompts = json_file(config_path).get("prompts", {})
    return str(prompts.get("query", ""))


def load_tower(
    root: Path,
    model_id: str,
    role: int,
    role_name: str,
    confirmed_prefix: str,
) -> Tower:
    config = json_file(root / "config.json")
    declared_prefix = declared_query_prefix(root) if confirmed_prefix else ""
    if declared_prefix != confirmed_prefix:
        raise ValueError(
            f"confirmed prefix {confirmed_prefix!r} differs from checkpoint "
            f"declaration {declared_prefix!r}"
        )
    model_type = config.get("model_type")
    if model_type == "bert":
        architecture = 1
    elif model_type == "gte":
        architecture = 2
    else:
        raise ValueError(f"unsupported architecture {model_type!r}")
    pooling_config = root / "1_Pooling" / "config.json"
    pooling_data = json_file(pooling_config) if pooling_config.is_file() else {}
    if pooling_data.get("pooling_mode_mean_tokens"):
        pooling = 1
    elif pooling_data.get("pooling_mode_lasttoken"):
        pooling = 3
    else:
        pooling = 2
    dense_config = root / "2_Dense" / "config.json"
    dense_out = int(json_file(dense_config)["out_features"]) if dense_config.is_file() else 0
    tensors = load_tensors(root, role_name, dense_out)
    weights = b"".join(tensor.data for tensor in tensors)
    return Tower(
        role=role,
        model_id=model_id,
        root=root,
        prefix=confirmed_prefix,
        config=config,
        pooling=pooling,
        architecture=architecture,
        dense_out=dense_out,
        tensors=tensors,
        weights_digest=xxhash.xxh3_128_intdigest(weights).to_bytes(16, "little"),
    )


def encode_tower(tower: Tower) -> bytes:
    config = tower.config
    hidden = int(config["hidden_size"])
    dims = tower.dense_out or hidden
    output = bytearray([tower.role])
    output += string(tower.model_id)
    output += string(tower.root.name)
    output += field(tower.weights_digest)
    output += u32(dims)
    output += u16(1)
    output += string(tower.prefix)
    output += u32(int(config["max_position_embeddings"]))
    output += u16(2)
    output += u16(2)
    output += b"\x00"
    output += bytes([tower.pooling])
    output += u16(tower.architecture)
    output += u16(int(config["num_hidden_layers"]))
    output += u32(hidden)
    output += u16(int(config["num_attention_heads"]))
    output += u32(int(config["intermediate_size"]))
    output += u32(int(config.get("type_vocab_size", 0)))
    output += u32(int(config["max_position_embeddings"]))
    output += struct.pack("<f", float(config["layer_norm_eps"]))
    output += struct.pack("<f", float(config.get("rope_theta", 10_000.0)))
    output += u32(tower.dense_out)
    return bytes(output)


def wordpiece_flags(tokenizer: dict) -> int:
    """Validate the complete single-sequence WordPiece contract representable in v1.

    Bundle limits/padding are selected by the caller, not tokenizer.json's saved
    encode options. Decoding and paired-sequence templates are never executed.
    """
    normalizer = tokenizer.get("normalizer", {})
    lower = normalizer.get("lowercase")
    strip = normalizer.get("strip_accents")
    if (normalizer.get("type") != "BertNormalizer"
            or normalizer.get("clean_text") is not True
            or normalizer.get("handle_chinese_chars") is not True
            or type(lower) is not bool
            or (strip is not None and type(strip) is not bool)
            or (lower and strip is False)):
        raise ValueError("bundle v1 requires BERT cleaning/CJK and uncased default accent stripping")
    if tokenizer.get("pre_tokenizer") != {"type": "BertPreTokenizer"}:
        raise ValueError("bundle v1 requires BertPreTokenizer")
    model = tokenizer["model"]
    if (model.get("type") != "WordPiece" or model.get("unk_token") != "[UNK]"
            or model.get("continuing_subword_prefix") != "##"
            or model.get("max_input_chars_per_word") != 100):
        raise ValueError("bundle v1 requires standard WordPiece with a 100-character limit")
    vocab = model["vocab"]
    if sorted(vocab.values()) != list(range(len(vocab))):
        raise ValueError("WordPiece vocabulary IDs must be contiguous from zero")
    specials = ["[PAD]", "[UNK]", "[CLS]", "[SEP]", "[MASK]"]
    if any(token not in vocab for token in specials):
        raise ValueError("bundle v1 requires the five standard BERT special tokens")
    expected_added = [{"id": vocab[token], "content": token, "single_word": False,
                       "lstrip": False, "rstrip": False, "normalized": False, "special": True}
                      for token in specials]
    added = tokenizer.get("added_tokens", [])
    if sorted(added, key=lambda token: token["id"]) != sorted(expected_added, key=lambda token: token["id"]):
        raise ValueError("bundle v1 cannot represent different or additional special-token matching")
    post = tokenizer.get("post_processor", {})
    expected_single = [{"SpecialToken": {"id": "[CLS]", "type_id": 0}},
                       {"Sequence": {"id": "A", "type_id": 0}},
                       {"SpecialToken": {"id": "[SEP]", "type_id": 0}}]
    expected_specials = {token: {"id": token, "ids": [vocab[token]], "tokens": [token]}
                         for token in ["[CLS]", "[SEP]"]}
    if (post.get("type") != "TemplateProcessing" or post.get("single") != expected_single
            or post.get("special_tokens") != expected_specials):
        raise ValueError("bundle v1 requires a single CLS/sequence/SEP template with type ID zero")
    return int(lower) | (int(lower if strip is None else strip) << 1)


def encode_tokenizer(root: Path, architecture: int) -> bytes:
    tokenizer = json_file(root / "tokenizer.json")
    config = json_file(root / "tokenizer_config.json")
    model = tokenizer["model"]
    if architecture == 1:
        kind = 1
        flags = wordpiece_flags(tokenizer)
        if ("do_lower_case" in config and config["do_lower_case"] is not bool(flags & 1)
                or "tokenize_chinese_chars" in config and config["tokenize_chinese_chars"] is not True):
            raise ValueError("tokenizer_config.json contradicts the BERT normalizer")
        if "strip_accents" in config:
            strip = config["strip_accents"]
            effective = bool(flags & 1) if strip is None else strip
            if effective is not bool(flags & 2):
                raise ValueError("tokenizer_config.json contradicts BERT accent stripping")
        if any(config.get(key, "right") != "right" for key in ["padding_side", "truncation_side"]):
            raise ValueError("bundle v1 requires right padding and right truncation")
        mask = config.get("mask_token", "[MASK]")
        if isinstance(mask, dict):
            mask = mask.get("content")
        if mask != "[MASK]" or config.get("extra_special_tokens"):
            raise ValueError("bundle v1 requires only the five standard BERT special tokens")
        added = {item["id"]: item for item in tokenizer["added_tokens"]}
        for configured_id, token in config.get("added_tokens_decoder", {}).items():
            if {"id": int(configured_id), **token} != added.get(int(configured_id)):
                raise ValueError("tokenizer_config.json contradicts BERT special-token matching")
        vocabulary = sorted(model["vocab"].items(), key=lambda item: item[1])
        entries = [(token, 0.0) for token, _ in vocabulary]
    elif model.get("type") == "Unigram":
        kind = 2
        flags = int(bool(config.get("do_lower_case", False)))
        entries = [(token, float(score)) for token, score in model["vocab"]]
    else:
        raise ValueError(f"unsupported tokenizer model {model.get('type')!r}")
    added = {item["content"]: int(item["id"]) for item in tokenizer.get("added_tokens", [])}
    vocab_ids = {token: index for index, (token, _) in enumerate(entries)}

    def token_id(name: str, fallback: str) -> int:
        value = config.get(name, fallback)
        if isinstance(value, dict):
            value = value.get("content", fallback)
        if value in added:
            return added[value]
        if value in vocab_ids:
            return vocab_ids[value]
        raise ValueError(f"tokenizer has no {name}: {value!r}")

    output = bytearray([kind, flags, 0, 0])
    for name, fallback in [("pad_token", "[PAD]" if kind == 1 else "<pad>"),
                           ("unk_token", "[UNK]" if kind == 1 else "<unk>"),
                           ("cls_token", "[CLS]" if kind == 1 else "<s>"),
                           ("sep_token", "[SEP]" if kind == 1 else "</s>")]:
        selected = token_id(name, fallback)
        if kind == 1 and selected != vocab_ids[fallback]:
            raise ValueError(f"bundle v1 requires the standard BERT {name}")
        output += u32(selected)
    output += u32(len(entries))
    for token, score in entries:
        output += string(token)
        output += struct.pack("<f", score)
    return bytes(output)


def tensor_descriptor(tensor: Tensor, offset: int) -> bytes:
    output = bytearray(string(tensor.name))
    output += bytes([0, len(tensor.shape), 0, 0])
    for dimension in tensor.shape:
        output += u32(dimension)
    output += u64(offset)
    output += u64(len(tensor.data))
    output += u64(tensor.digest)
    return bytes(output)


def bake(args: argparse.Namespace) -> None:
    document_root = Path(args.document).resolve()
    if args.query:
        document = load_tower(document_root, args.document_id, 0, "document", "")
        query = load_tower(Path(args.query).resolve(), args.query_id, 1, "query", args.query_prefix)
        towers = (document, query)
        alignment = bytes.fromhex(args.alignment_digest)
        tokenizer_root = query.root
    else:
        document = load_tower(
            document_root,
            args.document_id,
            0,
            "document",
            args.query_prefix,
        )
        towers = (document,)
        alignment = b""
        tokenizer_root = document.root
    if len(towers) == 2 and not alignment:
        raise ValueError("a two-tower bundle requires --alignment-digest")
    tokenizer = encode_tokenizer(tokenizer_root, towers[-1].architecture)
    if len(towers) == 2 and encode_tokenizer(document_root, document.architecture) != tokenizer:
        raise ValueError("bundle v1 has one tokenizer; document and query tokenizers must match")
    tensors = tuple(tensor for tower in towers for tensor in tower.tensors)

    prefix = bytearray(MAGIC + u32(VERSION) + u32(0) + bytes([len(towers)]) + b"\x00" * 7)
    for tower in towers:
        prefix += encode_tower(tower)
    prefix += tokenizer
    prefix += struct.pack("<d", args.alpha)
    prefix += u32(len(tensors))
    placeholder_descriptors = b"".join(tensor_descriptor(tensor, 0) for tensor in tensors)
    raw_header = len(prefix) + len(placeholder_descriptors) + len(field(alignment))
    header_len = int(math.ceil(raw_header / 4096.0) * 4096)
    prefix[12:16] = u32(header_len)

    unique: dict[tuple[int, int], tuple[int, bytes]] = {}
    data = bytearray()
    descriptors = bytearray()
    for tensor in tensors:
        key = (tensor.digest, len(tensor.data))
        stored = unique.get(key)
        if stored is not None and stored[1] == tensor.data:
            offset = stored[0]
        else:
            offset = header_len + len(data)
            unique[key] = (offset, tensor.data)
            data += tensor.data
        descriptors += tensor_descriptor(tensor, offset)
    body = prefix + descriptors + field(alignment)
    body += b"\x00" * (header_len - len(body))
    body += data
    body += xxhash.xxh3_128_intdigest(body).to_bytes(16, "little")
    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(body)
    print(
        json.dumps(
            {
                "output": str(output),
                "bytes": len(body),
                "bundle_digest": xxhash.xxh3_128_hexdigest(body[:-16]),
                "tower_weights": {
                    tower.model_id: tower.weights_digest.hex() for tower in towers
                },
                "unique_tensors": len(unique),
                "tensor_descriptors": len(tensors),
            },
            sort_keys=True,
        )
    )


def _linear(torch_module, tensors: dict[str, torch.Tensor], base: str):
    weight = tensors[f"{base}.weight"]
    bias = tensors.get(f"{base}.bias")
    layer = torch_module.nn.Linear(
        int(weight.shape[1]), int(weight.shape[0]), bias=bias is not None
    )
    layer.weight = torch_module.nn.Parameter(weight, requires_grad=False)
    if bias is not None:
        layer.bias = torch_module.nn.Parameter(bias, requires_grad=False)
    return layer


def _layer_norm(torch_module, tensors: dict[str, torch.Tensor], base: str, eps: float):
    weight = tensors[f"{base}.weight"]
    layer = torch_module.nn.LayerNorm(int(weight.shape[0]), eps=eps)
    layer.weight = torch_module.nn.Parameter(weight, requires_grad=False)
    layer.bias = torch_module.nn.Parameter(
        tensors[f"{base}.bias"], requires_grad=False
    )
    return layer


def _coreml_query_module(root: Path, sequence: int):
    config = json_file(root / "config.json")
    if config.get("model_type") != "bert":
        raise ValueError("CoreML query export currently requires BERT")
    tensors: dict[str, torch.Tensor] = {}
    with safe_open(root / "model.safetensors", framework="pt", device="cpu") as source:
        for name in source.keys():
            tensors[name] = source.get_tensor(name).detach().to(dtype=torch.float32)
    dense_path = root / "2_Dense" / "model.safetensors"
    if not dense_path.is_file():
        raise ValueError("CoreML query export requires the declared Dense head")
    with safe_open(dense_path, framework="pt", device="cpu") as source:
        tensors["dense.weight"] = source.get_tensor("linear.weight").to(
            dtype=torch.float32
        )
        tensors["dense.bias"] = source.get_tensor("linear.bias").to(dtype=torch.float32)

    heads = int(config["num_attention_heads"])
    hidden = int(config["hidden_size"])
    epsilon = float(config["layer_norm_eps"])

    class Block(torch.nn.Module):
        def __init__(self, layer: int) -> None:
            super().__init__()
            base = f"encoder.layer.{layer}"
            self.query = _linear(torch, tensors, f"{base}.attention.self.query")
            self.key = _linear(torch, tensors, f"{base}.attention.self.key")
            self.value = _linear(torch, tensors, f"{base}.attention.self.value")
            self.attention_output = _linear(
                torch, tensors, f"{base}.attention.output.dense"
            )
            self.attention_norm = _layer_norm(
                torch, tensors, f"{base}.attention.output.LayerNorm", epsilon
            )
            self.intermediate = _linear(
                torch, tensors, f"{base}.intermediate.dense"
            )
            self.output = _linear(torch, tensors, f"{base}.output.dense")
            self.output_norm = _layer_norm(
                torch, tensors, f"{base}.output.LayerNorm", epsilon
            )

        def forward(self, states, attention_bias):
            query = self.query(states).reshape(1, sequence, heads, hidden // heads)
            key = self.key(states).reshape(1, sequence, heads, hidden // heads)
            value = self.value(states).reshape(1, sequence, heads, hidden // heads)
            query = query.transpose(1, 2)
            key = key.transpose(1, 2)
            value = value.transpose(1, 2)
            scores = torch.matmul(query, key.transpose(-1, -2)) / math.sqrt(
                hidden // heads
            )
            attended = torch.matmul(torch.softmax(scores + attention_bias, dim=-1), value)
            attended = attended.transpose(1, 2).reshape(1, sequence, hidden)
            states = self.attention_norm(states + self.attention_output(attended))
            intermediate = torch.nn.functional.gelu(self.intermediate(states))
            return self.output_norm(states + self.output(intermediate))

    class QueryTower(torch.nn.Module):
        def __init__(self) -> None:
            super().__init__()
            self.word = torch.nn.Embedding.from_pretrained(
                tensors["embeddings.word_embeddings.weight"], freeze=True
            )
            self.position = torch.nn.Embedding.from_pretrained(
                tensors["embeddings.position_embeddings.weight"], freeze=True
            )
            self.token_type = torch.nn.Embedding.from_pretrained(
                tensors["embeddings.token_type_embeddings.weight"], freeze=True
            )
            self.embedding_norm = _layer_norm(
                torch, tensors, "embeddings.LayerNorm", epsilon
            )
            self.blocks = torch.nn.ModuleList(
                Block(layer) for layer in range(int(config["num_hidden_layers"]))
            )
            self.dense = _linear(torch, tensors, "dense")
            self.register_buffer(
                "positions", torch.arange(sequence, dtype=torch.int32).reshape(1, sequence)
            )

        def forward(self, input_ids, attention_mask):
            token_types = torch.zeros_like(input_ids)
            states = self.embedding_norm(
                self.word(input_ids)
                + self.position(self.positions)
                + self.token_type(token_types)
            )
            attention_bias = (attention_mask[:, None, None, :].to(torch.float32) - 1.0) * 1.0e9
            for block in self.blocks:
                states = block(states, attention_bias)
            mask = attention_mask[:, :, None].to(torch.float32)
            pooled = (states * mask).sum(dim=1) / mask.sum(dim=1)
            return torch.nn.functional.normalize(self.dense(pooled), p=2, dim=1)

    return QueryTower().eval()


def coreml_export(args: argparse.Namespace) -> None:
    try:
        import coremltools as ct
        import numpy as np
    except ImportError as error:
        raise RuntimeError("coreml-export requires coremltools in the tool venv") from error
    root = Path(args.query).resolve()
    sequence = args.tokens
    module = _coreml_query_module(root, sequence)
    input_ids = torch.ones((1, sequence), dtype=torch.int32)
    attention_mask = torch.ones((1, sequence), dtype=torch.int32)
    with torch.no_grad():
        traced = torch.jit.trace(module, (input_ids, attention_mask), strict=True)
    model = ct.convert(
        traced,
        convert_to="mlprogram",
        inputs=[
            ct.TensorType(name="input_ids", shape=(1, sequence), dtype=np.int32),
            ct.TensorType(name="attention_mask", shape=(1, sequence), dtype=np.int32),
        ],
        outputs=[ct.TensorType(name="embedding")],
        compute_precision=ct.precision.FLOAT16,
        minimum_deployment_target=ct.target.macOS15,
    )
    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    model.save(output)
    print(json.dumps({"output": str(output), "tokens": sequence}, sort_keys=True))


def coreml_run(args: argparse.Namespace) -> None:
    try:
        import coremltools as ct
        import numpy as np
    except ImportError as error:
        raise RuntimeError("coreml-run requires coremltools in the tool venv") from error
    compute_units = {
        "cpu": ct.ComputeUnit.CPU_ONLY,
        "cpu-and-gpu": ct.ComputeUnit.CPU_AND_GPU,
        "cpu-and-neural-engine": ct.ComputeUnit.CPU_AND_NE,
    }[args.compute_units]
    raw = Path(args.input).read_bytes()
    if len(raw) < 8:
        raise ValueError("CoreML input header is truncated")
    rows, tokens = struct.unpack_from("<II", raw)
    values = rows * tokens
    ids_end = 8 + values * 4
    mask_end = ids_end + values * 4
    if mask_end != len(raw):
        raise ValueError("CoreML input payload length does not match its shape")
    ids = np.frombuffer(raw[8:ids_end], dtype="<i4").reshape(rows, tokens)
    mask = np.frombuffer(raw[ids_end:mask_end], dtype="<f4").reshape(rows, tokens)
    clock = __import__("time")
    load_started = clock.perf_counter_ns()
    model = ct.models.MLModel(str(Path(args.model)), compute_units=compute_units)
    load_ms = (clock.perf_counter_ns() - load_started) / 1.0e6
    output = []
    latencies = []
    for row in range(rows):
        prediction = None
        row_latencies = []
        for iteration in range(args.warm + args.repeat):
            started = clock.perf_counter_ns()
            prediction = model.predict(
                {
                    "input_ids": ids[row : row + 1].astype(np.int32),
                    "attention_mask": mask[row : row + 1].astype(np.int32),
                }
            )["embedding"]
            if iteration >= args.warm:
                row_latencies.append(
                    (clock.perf_counter_ns() - started) / 1.0e6
                )
        if prediction is None:
            raise ValueError("CoreML repeat count must be non-zero")
        latencies.append(row_latencies)
        output.append(np.asarray(prediction, dtype="<f4").reshape(-1))
    Path(args.output).write_bytes(np.concatenate(output).tobytes())
    print(
        json.dumps(
            {
                "compute_units": args.compute_units,
                "model_load_ms": load_ms,
                "latency_ms": latencies,
            }
        )
    )


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="ze-model")
    commands = root.add_subparsers(dest="command", required=True)
    fetch = commands.add_parser("fetch")
    fetch.add_argument("model")
    bake_parser = commands.add_parser("bake")
    bake_parser.add_argument("--document", required=True)
    bake_parser.add_argument("--document-id", required=True)
    bake_parser.add_argument("--query")
    bake_parser.add_argument("--query-id")
    bake_parser.add_argument("--query-prefix", required=True)
    bake_parser.add_argument("--alignment-digest", default="")
    bake_parser.add_argument("--alpha", type=float, default=0.5)
    bake_parser.add_argument("--output", required=True)
    export = commands.add_parser("coreml-export")
    export.add_argument("--query", required=True)
    export.add_argument("--tokens", type=int, choices=(1, 16, 32, 64, 128, 256), default=32)
    export.add_argument("--output", required=True)
    run = commands.add_parser("coreml-run")
    run.add_argument("--model", required=True)
    run.add_argument("--input", required=True)
    run.add_argument(
        "--compute-units",
        choices=("cpu", "cpu-and-gpu", "cpu-and-neural-engine"),
        required=True,
    )
    run.add_argument("--output", required=True)
    run.add_argument("--warm", type=int, default=0)
    run.add_argument("--repeat", type=int, default=1)
    return root


def main() -> None:
    args = parser().parse_args()
    if args.command == "fetch":
        print(snapshot_download(args.model))
        return
    if args.command == "coreml-export":
        coreml_export(args)
        return
    if args.command == "coreml-run":
        coreml_run(args)
        return
    if args.query and not args.query_id:
        raise ValueError("--query-id is required with --query")
    bake(args)


if __name__ == "__main__":
    main()
