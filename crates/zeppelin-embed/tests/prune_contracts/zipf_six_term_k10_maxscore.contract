# Zipf 2,000 documents, terms t0..t5, k=10, block-max MAXSCORE
#
# Re-baselined twice, for two different reasons:
#
# When the query path began reading the sealed posting format, two
# counters changed MEANING: blocks_decoded stopped counting bound blocks
# BUILT and began counting blocks actually unpacked out of the persisted
# bytes, and blocks_skipped stopped charging the cursor's own partially
# consumed block.
#
# When MAXSCORE's probe order was fixed: cursors are now probed
# DESCENDING by upper bound with a metadata-only block bound tested
# before every seek, so a candidate that provably cannot reach the
# threshold no longer forces the cheap cursors' seeks and decodes.
# postings_decoded fell 41% (2,253 to 1,321) and ten fewer candidates
# survive to a heap offer; the equivalence property held throughout.
docs_evaluated = 62
blocks_decoded = 74
blocks_skipped = 5
postings_decoded = 1321
