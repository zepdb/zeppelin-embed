[
  {
    "name": "core-tests",
    "command": [
      "cargo",
      "llvm-cov",
      "test",
      "--no-report",
      "-p",
      "zeppelin-embed",
      "--features",
      "allocation-audit",
      "--lib",
      "--test",
      "graph_catalog",
      "--",
      "--test-threads=1"
    ],
    "exit_code": 0
  },
  {
    "name": "oracle-tests",
    "command": [
      "cargo",
      "llvm-cov",
      "test",
      "--no-report",
      "-p",
      "zeppelin-embed-adversarial-oracle",
      "--test",
      "graph_catalog"
    ],
    "exit_code": 0
  },
  {
    "name": "oracle-probe-tests",
    "command": [
      "cargo",
      "llvm-cov",
      "test",
      "--no-report",
      "-p",
      "zeppelin-embed-workspace-tests",
      "--test",
      "adversarial_tests",
      "property_graph",
      "--",
      "--nocapture"
    ],
    "exit_code": 0
  },
  {
    "name": "combined-smoke",
    "command": [
      "cargo",
      "llvm-cov",
      "test",
      "--no-report",
      "-p",
      "zeppelin-embed-workspace-tests",
      "--test",
      "adversarial_tests",
      "smoke",
      "--",
      "--exact",
      "--nocapture"
    ],
    "exit_code": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "-p",
      "zeppelin-embed",
      "-p",
      "zeppelin-embed-adversarial-oracle",
      "-p",
      "zeppelin-embed-workspace-tests",
      "--all-targets",
      "--features",
      "zeppelin-embed/test-support,zeppelin-embed/allocation-audit",
      "--no-deps",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "workspace-coverage",
    "command": [
      "cargo",
      "llvm-cov",
      "report",
      "--fail-under-lines",
      "90",
      "--ignore-filename-regex",
      "(^|/)(registry/|crates/zeppelin-embed-bench|fuzz/|target/)",
      "--json",
      "--output-path",
      "/tmp/ze-35-integration/workspace-coverage.json"
    ],
    "exit_code": 0
  },
  {
    "name": "oracle-coverage",
    "command": [
      "cargo",
      "llvm-cov",
      "report",
      "--no-default-ignore-filename-regex",
      "--ignore-filename-regex",
      "(^|/)(registry/|crates/zeppelin-embed-bench|fuzz/|target/|rustc/)|/\\.rustup/",
      "--json",
      "--output-path",
      "/tmp/ze-35-integration/oracle-coverage.json"
    ],
    "exit_code": 0
  }
]
