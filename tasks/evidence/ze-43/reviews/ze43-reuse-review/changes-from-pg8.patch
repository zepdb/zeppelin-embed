+            let mut encoded = [0; 9];
+            assert_eq!(value.read_at(0, &mut encoded, &mut r).unwrap(), 9);
+            assert_eq!(encoded[0], 3);
+            assert_eq!(
+                i64::from_le_bytes(encoded[1..].try_into().unwrap()),
+                (COUNT - index - 1) as i64
