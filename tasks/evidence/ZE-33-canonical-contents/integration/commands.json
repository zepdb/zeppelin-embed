[
  {
    "name": "core-tests",
    "command": [
      "cargo",
      "llvm-cov",
      "test",
      "--no-report",
      "-p",
      "zeppelin-embed",
      "--features",
      "test-support",
      "--test",
      "graph_canonical"
    ],
    "exit_code": 0
  },
  {
    "name": "oracle-probe-tests",
    "command": [
      "cargo",
      "llvm-cov",
      "test",
      "--no-report",
      "-p",
      "zeppelin-embed-workspace-tests",
      "--test",
      "adversarial_tests",
      "graph_contents",
      "--",
      "--nocapture"
    ],
    "exit_code": 0
  },
  {
    "name": "workspace-coverage",
    "command": [
      "cargo",
      "llvm-cov",
      "report",
      "--fail-under-lines",
      "90",
      "--ignore-filename-regex",
      "(^|/)(registry/|crates/zeppelin-embed-bench|fuzz/|target/)",
      "--json",
      "--output-path",
      "/tmp/ze-33-integration/workspace-coverage.json"
    ],
    "exit_code": 0
  },
  {
    "name": "oracle-coverage",
    "command": [
      "cargo",
      "llvm-cov",
      "report",
      "--no-default-ignore-filename-regex",
      "--ignore-filename-regex",
      "(^|/)(registry/|crates/zeppelin-embed-bench|fuzz/|target/|rustc/)|/\\.rustup/",
      "--json",
      "--output-path",
      "/tmp/ze-33-integration/oracle-coverage.json"
    ],
    "exit_code": 0
  }
]
